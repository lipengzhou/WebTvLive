{
  "manifest_version": 2,
  "name": "WebTvLive Player Adapter",
  "version": "1.9",
  "description": "Adapts official live pages for fullscreen TV playback.",
  "browser_specific_settings": {
    "gecko": {
      "id": "webtvlive@lipengzhou.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.yangshipin.cn/*"
      ],
      "js": ["player_adapter.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
