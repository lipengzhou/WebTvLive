<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- 官网直播页承载容器：GeckoView 在代码中创建后加入，避免依赖电视的旧系统 WebView -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 保留的全屏视频兜底容器（GeckoView 当前通过页面样式直接全屏） -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <!-- 加载遮罩：全屏不透明黑底，盖住网页导航与未起播的封面/播放按钮，
         直到视频真正开播（JS 回传 notifyVideoPlaying）才切走 -->
    <TextView
        android:id="@+id/loadingText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:text="@string/loading"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <!-- 换台时短暂显示的频道名浮层（默认隐藏） -->
    <TextView
        android:id="@+id/channelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 侧边频道菜单（默认隐藏）：
         贴左显示，只占屏幕左侧一部分，右侧留空让视频继续可见、继续播放。
         左区 = 分类列表，右区 = 该分类下的频道列表，都是垂直滚动。 -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 左：分类 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryList"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:background="@color/menu_category_bg"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- 右：所选分类下的频道 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:background="@color/menu_channel_bg"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

    </LinearLayout>

</FrameLayout>
