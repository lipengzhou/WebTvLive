{
  "manifest_version": 2,
  "name": "WebTvLive Player Adapter",
  "version": "2.8",
  "description": "Adapts official live pages for fullscreen TV playback.",
  "browser_specific_settings": {
    "gecko": {
      "id": "webtvlive@lipengzhou.com"
    }
  },
  "background": {
    "scripts": ["request_filter.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.yangshipin.cn/*"
      ],
      "js": ["protocol.js", "player_adapter.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "https://*.yangshipin.cn/*"
  ]
}
